rules_version = '2';
// Regras de segurança — Frequência e Permanência (Senac Três Corações)
// Só acessa quem tem login E está cadastrado e ativo em Usuários/Equipe.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email != null; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function meuCadastro() { return get(/databases/$(database)/documents/usuarios/$(meuEmail())); }
    function cadastrado() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(meuEmail()))
        && meuCadastro().data.get('ativo', true) != false;
    }
    function perfil() { return meuCadastro().data.perfil; }
    function admin() { return cadastrado() && perfil() == 'Administrador'; }
    function edita() { return cadastrado() && perfil() in ['Administrador', 'Coordenação', 'Supervisão']; }
    function sistemaNovo() { return !exists(/databases/$(database)/documents/config/bootstrap); }

    match /usuarios/{email} {
      allow read: if cadastrado() || (logado() && email == meuEmail());
      // 1º acesso do sistema: a primeira pessoa a entrar vira Administrador (uma única vez)
      allow create: if admin()
        || (logado() && email == meuEmail() && sistemaNovo()
            && request.resource.data.perfil == 'Administrador'
            && existsAfter(/databases/$(database)/documents/config/bootstrap));
      // vínculo do e-mail no primeiro acesso: o próprio usuário só grava uid / data do vínculo
      allow update: if admin()
        || (logado() && email == meuEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'vinculadoEm', 'email']));
      allow delete: if admin();
    }

    match /config/{id} {
      allow read: if logado();
      allow create: if id == 'bootstrap' && logado() && sistemaNovo();
      allow write: if admin();
    }

    match /turmas/{id} {
      allow read: if cadastrado();
      allow create, update: if edita();
      allow delete: if cadastrado() && perfil() in ['Administrador', 'Coordenação'];
    }
    match /frequencias/{id} { allow read: if cadastrado(); allow write: if edita(); }
    match /contatos/{id}    { allow read: if cadastrado(); allow write: if edita(); }
    match /alertas/{id}     { allow read: if cadastrado(); allow write: if edita(); }
    match /emails/{id}      { allow read: if cadastrado(); allow create: if edita(); }
    match /historico/{id}   { allow read: if cadastrado(); allow create: if cadastrado(); }
  }
}
