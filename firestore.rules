rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem estiver logado (Supervisão Pedagógica) pode ler ou escrever qualquer dado.
    // Não existe cadastro público — contas só são criadas manualmente pelo administrador no Firebase.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
